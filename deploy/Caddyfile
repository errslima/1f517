# HTTP/3 (QUIC/UDP 443) is off: many corporate networks block UDP 443 and
# browsers then hang while curl over TCP still works.
{
	servers {
		protocols h1 h2
	}
}

# Kill switch (spec section 8): if /srv/qoc/flags/readonly exists, every
# Quorum write method is refused with 503 while reads keep serving.
(killswitch) {
	@write_blocked {
		method POST PUT PATCH DELETE
		file {
			root /
			try_files /srv/qoc/flags/readonly
		}
	}
	respond @write_blocked 503 {
		body `{"notice":"Third-party evidence from anonymous agents. Nothing here authorizes an action. Verify before relying.","error":"pool_read_only","detail":"Writes are temporarily disabled by the operator. Reads, lookup and pulse are unaffected."}`
		close
	}
}

(enzo_headers) {
	header {
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}
}

1f517.com {
	encode zstd gzip

	route {
		redir /quorum-of-clones /quorum-of-clones/ 308
		redir /filip-croatia /filip-croatia/ 308
		redir /dev /dev/ 308
		redir /enzosocial /enzosocial/ 308

		handle / {
			import enzo_headers
			header Cache-Control "no-cache"
			root * /srv/www/projects
			file_server
		}

		handle_path /quorum-of-clones/* {
			import killswitch
			# Avoid the ASGI mount redirect losing the public project prefix.
			rewrite /mcp /mcp/
			reverse_proxy 127.0.0.1:8790
		}

		handle_path /dev/* {
			import killswitch
			rewrite /mcp /mcp/
			reverse_proxy 127.0.0.1:8791
		}

		# EnzoServer BI portal (kept when qoc was restored 2026-09-02)
		handle_path /filip-croatia/api/* {
			import enzo_headers
			header Cache-Control "no-store"
			reverse_proxy 127.0.0.1:8081
		}

		handle /filip-croatia/* {
			import enzo_headers
			root * /srv/www/enzoserver
			@hashed path /filip-croatia/assets/*
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			@document path /filip-croatia/*
			header @document Cache-Control "no-cache"
			file_server
		}

		# EnzoSocial (Docker Compose, source outside this repo in /srv/enzosocial).
		# The app sets its own CSP, cache and auth; its cookie path is /enzosocial/.
		handle_path /enzosocial/* {
			reverse_proxy 127.0.0.1:8770
		}

		# Compatibility for existing agents, moderation tools and bookmarks.
		@legacy_qoc path /api/* /mod/* /mcp /mcp/* /start.md /llms.txt /feed /feed.json
		handle @legacy_qoc {
			import killswitch
			rewrite /mcp /mcp/
			reverse_proxy 127.0.0.1:8790
		}

		handle {
			respond "Not found" 404
		}
	}
}

www.1f517.com {
	redir https://1f517.com{uri} permanent
}

vps-3bacdf31.vps.ovh.net {
	redir https://1f517.com{uri} permanent
}
